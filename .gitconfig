[user]
	name = Jeremy A. Prescott
	email = jap@prescore.ch

# [user]
# 	name = Jeremy A. Prescott
# 	email = jeremy@lightly.ai


# [user]
# 	name = Jeremy A. Prescott
# 	email = jeremy@roboflow.com


[color]
	ui = true

[core]
	excludesfile = ~/.gitignore
	attributesfile = ~/.gitattributes
[push]
	default = current

[help]
	autocorrect = 1


[alias]
	st = status
	ci = commit
	co = checkout
	br = branch
	d = diff
	dt = difftool
	fuck = !sh -c 'git commit --amend' -
    fixup = !sh -c 'git commit -m \"fixup! $(git log -1 --format='\\''%s'\\'' $@)\"' -
    squash = !sh -c 'git commit -m \"squash! $(git log -1 --format='\\''%s'\\'' $@)\"' -
    ri = rebase --interactive --autosquash

[color]
	diff = auto
	status = auto
	branch = auto
	user = jeremy


[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[core]
	whitespace = trailing-space,space-before-tab,cr-at-eol
	excludesfile = /Users/jeremy/.gitignore
	ignorecase = false
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	syntax-theme = gruvbox-dark

[credential]
	helper = cache --timeout=7200

[push]
	default = current

[branch "master"]
	mergeoptions = --no-ff

[rerere]
	enabled = true

[status]
	submoduleSummary = true


[log]
	date = relative

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
	rebase = false
[url "https://github.com/"]
	insteadOf = ssh://git@github.com/
	insteadOf = git@github.com:
